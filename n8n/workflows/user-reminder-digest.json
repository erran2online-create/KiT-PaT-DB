{
  "name": "KiT-PaT User Reminder Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "cron-hourly",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/rpc/get_users_due_for_reminder",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "id": "fetch-due-users",
      "name": "Fetch users due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst rows = Array.isArray(raw) ? raw : (Array.isArray(raw?.data) ? raw.data : [raw]);\nconst out = [];\nfor (const u of rows) {\n  if (!u || !u.user_id) continue;\n  out.push({ json: u });\n}\nif (out.length === 0) {\n  return [{ json: { skip: true, reason: 'no users due' } }];\n}\nreturn out;"
      },
      "id": "split-users",
      "name": "Split users",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.skip}}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-skip",
      "name": "Skip empty",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        740,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ok: true, skipped: true } }];"
      },
      "id": "noop-skip",
      "name": "No users",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const u = $json;\nconst when = u.upcoming_party_date || '';\nconst title = u.upcoming_event_title || 'your party';\nconst group = u.group_name || 'your group';\nconst name = u.user_name || 'there';\nconst text = [\n  `Hi ${name} \u2014 reminder from KiT-PaT`,\n  `Party: ${title}`,\n  `Group: ${group}`,\n  `When: ${when}`,\n  `Frequency: ${u.frequency} (slot ${u.slot_index}/${u.slots_today})`,\n  '',\n  '(Digest \u2014 DMs use telegram_id when linked; otherwise support chat.)'\n].join('\\n');\nreturn [{ json: {\n  text,\n  user_id: u.user_id,\n  slot_index: u.slot_index,\n  chat_id: u.telegram_id || null\n} }];"
      },
      "id": "build-msg",
      "name": "Build Telegram message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/functions/v1/send-telegram",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.chat_id ? { text: $json.text, chat_id: $json.chat_id } : { text: $json.text }) }}",
        "options": {}
      },
      "id": "telegram-send",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/rpc/n8n_mark_user_reminder_sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_user_id: $('Build Telegram message').item.json.user_id, p_slot_index: $('Build Telegram message').item.json.slot_index }) }}",
        "options": {}
      },
      "id": "mark-sent",
      "name": "Mark user reminder sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        -100
      ]
    }
  ],
  "connections": {
